{
  "name": "micropatches",
  "version": "1.0.0",
  "description": "Small, targeted patches for specific Obsidian bugs and performance issues.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "pnpm typecheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "postversion": "git push --follow-tags",
    "release": "pnpm version --tag-version-prefix ''",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
  },
  "release": {
    "mainJsBudgetBytes": 65536
  },
  "keywords": [],
  "license": "MIT",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.13.3",
    "esbuild": "0.28.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.11.0",
    "jiti": "^2.7.0",
    "obsidian": "latest",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
